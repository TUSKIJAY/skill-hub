#!/usr/bin/env python3
"""Dependency-free structural and state-file lint for the project-local harness."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


MINIMAL = (
    "AGENTS.md",
    "INSTRUCTIONS.md",
    "PROGRESS.md",
    "HANDOFF.md",
    ".harness/config.json",
    "scripts/check-project-harness.py",
    "scripts/check-startup-doc-budget.py",
    "scripts/harness_log.py",
    "scripts/harness_read.py",
)

GOVERNED = (
    "docs/README.md",
    "docs/exec-plans/roadmap.md",
    "docs/exec-plans/proposed/index.md",
    "docs/exec-plans/active/index.md",
    "docs/exec-plans/completed/index.md",
    "docs/exec-plans/reviews/index.md",
    "docs/prd/index.md",
    "docs/decisions/index.md",
    "docs/specs/index.md",
    "docs/optimization/SOP.md",
    "docs/progress-archive/index.md",
)

DECISIONS_PLACEHOLDER_ROW = "| None | — | — | — | — |"
DECISIONS_TEMPLATE_FILES = {"index.md", "decision-template.md"}

HANDOFF_REQUIRED_KEYS = (
    "progress_ref:",
    "just_finished:",
    "current_task:",
    "first_action:",
    "do_not:",
    "open_questions:",
    "verify:",
)

# AGENTS.md must route to the state files, or an install next to an existing AGENTS.md has no effect.
AGENTS_REQUIRED_ROUTES = ("INSTRUCTIONS.md", "PROGRESS.md", "HANDOFF.md")

PROGRESS_REQUIRED_HEADINGS = (
    "## Facts",
    "## In Progress",
    "## Blocked",
    "## Backlog",
    "## Open Unknowns",
    "## Verified Baseline",
    "## Completed",
)

# Context Budget: install-time defaults of `context_budget`, and where INSTRUCTIONS.md states each value.
# Every occurrence found must equal the config value (the default when the config omits the field). The
# patterns also read the wording of earlier installs (一次最多 N 行, <日期>), so a section kept as it was still
# gets its numbers compared.
CONTEXT_BUDGET_DEFAULTS = {{CONTEXT_BUDGET_INLINE}}
# A `## ` heading whose title starts with one of these opens the section; a mention elsewhere does not count.
CONTEXT_BUDGET_TITLES = ("context budget", "上下文预算")
CONTEXT_BUDGET_PATTERNS = {
    "file_lines": (r"总行数不超过 (\d+)",),
    "file_bytes": (r"总字节不超过 (\d+)",),
    "output_lines": (r"(?:合计|一次)最多 (\d+) 行", r"确定在 (\d+) 行以内", r"先取前 (\d+) 条", r"每页不超过 (\d+) 条"),
    "output_bytes": (r"条或 (\d+) 字节",),
    "head_lines": (r"前 (\d+) 行", r"结论不超过 (\d+) 行"),
    "scratch_dir": (r"重定向到 `([^`]+?)/<(?:YYYY-MM-DD|日期)>",),
}

{{TASK_CARD_CONSTANTS}}
# Reads accept an optional UTF-8 BOM in user-maintained files.
READ_ENCODING = "utf-8-sig"


def ensure_utf8_stdio() -> None:
    """Force UTF-8 stdout/stderr so Chinese text survives a GBK console or pipe."""
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, OSError, ValueError) as exc:
            print(f"WARNING: cannot switch output to UTF-8: {exc}", file=sys.stderr)


def infer_profile(root: Path) -> str:
    config = root / ".harness" / "config.json"
    if config.is_file():
        try:
            value = json.loads(config.read_text(encoding=READ_ENCODING)).get("profile")
            if value in {"minimal", "governed"}:
                return value
        except (OSError, UnicodeDecodeError, json.JSONDecodeError, AttributeError):
            pass
    return "governed" if (root / "docs/exec-plans/roadmap.md").is_file() else "minimal"


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding=READ_ENCODING)
    except (OSError, UnicodeDecodeError):
        return ""


def lint_state_files(root: Path) -> list[dict[str, object]]:
    agents = read_text(root / "AGENTS.md")
    handoff = read_text(root / "HANDOFF.md")
    progress = read_text(root / "PROGRESS.md")
    lint: list[dict[str, object]] = []
    for name in AGENTS_REQUIRED_ROUTES:
        lint.append(
            {
                "label": f"AGENTS.md routes to `{name}`",
                "path": "AGENTS.md",
                "passed": name.lower() in agents.lower(),
            }
        )
    for key in HANDOFF_REQUIRED_KEYS:
        lint.append(
            {
                "label": f"HANDOFF.md carries `{key}` field",
                "path": "HANDOFF.md",
                "passed": key in handoff,
            }
        )
    for heading in PROGRESS_REQUIRED_HEADINGS:
        lint.append(
            {
                "label": f"PROGRESS.md keeps `{heading}` section",
                "path": "PROGRESS.md",
                "passed": heading in progress,
            }
        )
    lint.append(
        {
            "label": "PROGRESS.md points history reads at harness_log.py",
            "path": "PROGRESS.md",
            "passed": "harness_log.py" in progress,
        }
    )
    return lint


def lint_entry_pointer(root: Path) -> list[dict[str, object]]:
    """Claude Code auto-loads CLAUDE.md, not AGENTS.md: a CLAUDE.md that exists must point at AGENTS.md."""
    claude = root / "CLAUDE.md"
    if not claude.is_file():
        return []
    return [{
        "label": "CLAUDE.md points to `AGENTS.md` (Claude Code loads CLAUDE.md, not AGENTS.md)",
        "path": "CLAUDE.md",
        "passed": "agents.md" in read_text(claude).lower(),
    }]


def context_budget_section(text: str) -> list[tuple[int, str]] | None:
    """(line number, line) of the INSTRUCTIONS.md Context Budget section; None when it has no such heading."""
    found: list[tuple[int, str]] | None = None
    inside = False
    for number, line in enumerate(text.splitlines(), start=1):
        if line.startswith("## "):
            inside = line[3:].strip().lower().startswith(CONTEXT_BUDGET_TITLES)
            if inside and found is None:
                found = []
            continue
        if inside and found is not None:
            found.append((number, line))
    return found


def scratch_dir_problem(value: object) -> str | None:
    """Why `value` is not a relative directory inside the project (the installer's rule); None when it is."""
    if not isinstance(value, str):
        return "is not a string"
    text = value.strip().replace("\\", "/")
    parts = [part for part in text.split("/") if part not in ("", ".")]
    if not parts:
        return "is empty"
    if text.startswith("/") or any(":" in part for part in parts):
        return "is absolute"
    if any(part == ".." for part in parts):
        return "leaves the project (..)"
    if any(part.lower() == ".git" for part in parts):
        return "is inside .git"
    return None


def lint_context_budget(root: Path, config: object) -> tuple[list[dict[str, object]], list[str]]:
    """INSTRUCTIONS.md Context Budget numbers must match `.harness/config.json` `context_budget`."""
    lint: list[dict[str, object]] = []
    warnings: list[str] = []
    block = config.get("context_budget") if isinstance(config, dict) else None
    expected = dict(CONTEXT_BUDGET_DEFAULTS)
    if block is None:
        warnings.append(".harness/config.json has no context_budget; scripts/harness_read.py uses its built-in limits")
    elif not isinstance(block, dict):
        lint.append({"label": ".harness/config.json context_budget is an object", "path": ".harness/config.json",
                     "passed": False})
        block = {}
    for key, value in (block or {}).items():
        if key not in expected:
            continue
        if key == "scratch_dir":
            problem = scratch_dir_problem(value)
            label = (".harness/config.json context_budget.scratch_dir is a relative path inside the project"
                     if problem is None else
                     f".harness/config.json context_budget.scratch_dir={value!r} {problem}; use a relative path "
                     "inside the project")
            lint.append({"label": label, "path": ".harness/config.json", "passed": problem is None})
            if problem is None:
                expected[key] = "/".join(part for part in value.strip().replace("\\", "/").split("/")
                                         if part not in ("", "."))
            continue
        valid = isinstance(value, int) and not isinstance(value, bool) and value > 0
        lint.append({"label": f".harness/config.json context_budget.{key} is a positive integer",
                     "path": ".harness/config.json", "passed": valid})
        if valid:
            expected[key] = value
    section = context_budget_section(read_text(root / "INSTRUCTIONS.md"))
    if section is None:
        warnings.append("INSTRUCTIONS.md has no Context Budget section; paste it from the apply preview")
        return lint, warnings
    for key, patterns in CONTEXT_BUDGET_PATTERNS.items():
        stated = [(number, match.group(1)) for number, line in section for pattern in patterns
                  for match in re.finditer(pattern, line)]
        if not stated:
            warnings.append(f"INSTRUCTIONS.md Context Budget does not state {key}; cannot compare it with the config")
        for number, value in stated:
            want = str(expected[key])
            lint.append({
                "label": f"INSTRUCTIONS.md line {number} states {key}={value} matching .harness/config.json"
                if value == want else
                f"INSTRUCTIONS.md line {number} states {key}={value} but .harness/config.json context_budget.{key}"
                f"={want}; change one so they agree",
                "path": "INSTRUCTIONS.md",
                "passed": value == want,
            })
    return lint, warnings


def lint_governance_warnings(root: Path, profile: str) -> list[str]:
    warnings: list[str] = []
    if profile != "governed":
        return warnings

    decisions_index = read_text(root / "docs/decisions/index.md")
    if DECISIONS_PLACEHOLDER_ROW not in decisions_index:
        return warnings

    decisions_dir = root / "docs/decisions"
    extra_md = []
    if decisions_dir.is_dir():
        extra_md = [
            path.name
            for path in decisions_dir.glob("*.md")
            if path.name not in DECISIONS_TEMPLATE_FILES
        ]
    if extra_md:
        warnings.append(
            "docs/decisions/index.md still holds the template placeholder row despite decision files; "
            "register decisions when a plan carries constraining trade-offs"
        )
    return warnings


{{TASK_CARD_LINT}}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--profile", choices=("auto", "minimal", "governed"), default="auto")
    args = parser.parse_args(argv)

    root = args.root.expanduser().resolve()
    profile = infer_profile(root) if args.profile == "auto" else args.profile
    required = list(MINIMAL) + (list(GOVERNED) if profile == "governed" else [])
    files = [{"path": relative, "present": (root / relative).is_file()} for relative in required]

    config_error = None
    config = None
    try:
        config = json.loads((root / ".harness/config.json").read_text(encoding=READ_ENCODING))
        if config.get("schema_version") != "project-harness-config-v1":
            config_error = "unsupported schema_version"
        elif config.get("profile") != profile:
            config_error = f"profile mismatch: config={config.get('profile')} requested={profile}"
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, AttributeError) as exc:
        config_error = f"{type(exc).__name__}: {exc}"

    budget_lint, budget_warnings = lint_context_budget(root, config)
    lint = lint_state_files(root) + lint_entry_pointer(root) + budget_lint + lint_task_cards(root)
    lint_failures = [item for item in lint if not item["passed"]]
    missing = [item["path"] for item in files if not item["present"]]
    warnings = lint_governance_warnings(root, profile) + budget_warnings
    payload = {
        "schema_version": "project-local-harness-check-v2",
        "root": str(root),
        "profile": profile,
        "files": files,
        "missing": missing,
        "lint": lint,
        "lint_failures": [item["label"] for item in lint_failures],
        "warnings": warnings,
        "config_error": config_error,
        "passed": not missing and not lint_failures and config_error is None,
    }
    print(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
    if missing:
        print("Missing harness files:", file=sys.stderr)
        for relative in missing:
            print(f"  - {relative}", file=sys.stderr)
    if lint_failures:
        print("State-file lint failures:", file=sys.stderr)
        for item in lint_failures:
            print(f"  - {item['label']}", file=sys.stderr)
    if warnings:
        print("Warnings:", file=sys.stderr)
        for item in warnings:
            print(f"  - {item}", file=sys.stderr)
    if config_error:
        print(f"Config error: {config_error}", file=sys.stderr)
    return 0 if payload["passed"] else 1


if __name__ == "__main__":
    ensure_utf8_stdio()
    raise SystemExit(main())
